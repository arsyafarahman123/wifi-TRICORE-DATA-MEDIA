# Deny executing any PHP or executable scripts inside uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|pl|py|cgi|sh|bash|exe|asp|aspx)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent script execution via Handler
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI

